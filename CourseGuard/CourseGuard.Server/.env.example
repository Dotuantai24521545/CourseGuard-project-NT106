COURSEGUARD_DB_CONNECTION=Host=YOUR_HOST;Port=5432;Database=postgres;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;Timeout=15
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASS=YOUR_APP_PASSWORD
SMTP_FROM_EMAIL=sender@example.com
SMTP_FROM_NAME=CourseGuard

# Lớp học WebRTC (tùy chọn). Server gửi danh sách này cho client đã đăng nhập qua /api/classroom/ice-servers.
# Học viên khác mạng/NAT chặt cần TURN; không điền thì chỉ dùng STUN mặc định.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
