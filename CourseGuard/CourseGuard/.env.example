# Copy to .env in this directory. Never commit real credentials.
COURSEGUARD_DB_CONNECTION=Host=YOUR_DB_HOST;Port=5432;Database=postgres;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Timeout=15
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# Override with a model available to your OpenRouter account.
OPENROUTER_MODEL=openrouter/free
