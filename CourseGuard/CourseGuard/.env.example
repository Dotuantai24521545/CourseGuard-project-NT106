# Copy to .env in this directory. Never commit real credentials.
COURSEGUARD_DB_CONNECTION=Host=YOUR_DB_HOST;Port=5432;Database=postgres;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Timeout=15
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# Override with a model available to your OpenRouter account.
OPENROUTER_MODEL=openrouter/free

# Required for the SMTP/OTP email flow; uncomment and provide real values.
# Seed accounts use .local recipients; use a valid test email for UI login.
# SMTP_HOST=YOUR_SMTP_HOST
# SMTP_PORT=587
# SMTP_USER=YOUR_SMTP_USER
# SMTP_PASS=YOUR_SMTP_PASSWORD
# SMTP_FROM_EMAIL=YOUR_SENDER_EMAIL
# SMTP_FROM_NAME=CourseGuard Dev
# OTP_EXPIRY_MINUTES=5

# Required by Storage/Realtime integrations, separately from PostgreSQL.
# Configure buckets/policies and realtime access for your project as well.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Classroom services can read this relay endpoint; verify all client endpoints.
# RELAY_WS_URL=ws://localhost:8080
